---
// Root landing redirect with complete Open Graph & SEO metadata for crawlers (Facebook, LinkedIn, Twitter, etc.)
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SliceBill — Podziel wydatki bez konta</title>
    <meta
      name="description"
      content="SliceBill to darmowa aplikacja do podziału wydatków grupowych. Działa offline, chroni prywatność, obsługuje wiele walut. Bez rejestracji."
    />

    <link rel="canonical" href="https://slicebill.app/" />
    <link rel="alternate" hreflang="pl" href="https://slicebill.app/pl/" />
    <link rel="alternate" hreflang="en" href="https://slicebill.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://slicebill.app/en/" />

    <!-- Open Graph (Facebook, LinkedIn, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://slicebill.app/" />
    <meta property="og:title" content="SliceBill — Podziel wydatki bez konta" />
    <meta
      property="og:description"
      content="SliceBill to darmowa aplikacja do podziału wydatków grupowych. Działa offline, chroni prywatność, obsługuje wiele walut. Bez rejestracji."
    />
    <meta property="og:image" content="https://slicebill.app/og-image.png" />
    <meta property="og:image:secure_url" content="https://slicebill.app/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SliceBill — Podziel wydatki bez konta" />
    <meta property="og:site_name" content="SliceBill" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SliceBill — Podziel wydatki bez konta" />
    <meta
      name="twitter:description"
      content="SliceBill to darmowa aplikacja do podziału wydatków grupowych. Działa offline, chroni prywatność, obsługuje wiele walut. Bez rejestracji."
    />
    <meta name="twitter:image" content="https://slicebill.app/og-image.png" />
    <meta name="twitter:image:alt" content="SliceBill — Podziel wydatki bez konta" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/slicebill.png" />
    <link rel="apple-touch-icon" href="/slicebill.png" />

    <!-- Redirects -->
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>
      (function () {
        var userLang = (navigator.language || navigator.userLanguage || "").toLowerCase();
        if (userLang.indexOf("pl") === 0) {
          window.location.replace("/pl/");
        } else {
          window.location.replace("/en/");
        }
      })();
    </script>
  </head>
  <body class="bg-[#09090b] text-white">
    <noscript>
      <p style="text-align: center; margin-top: 2rem;">
        Przejdź do: <a href="/pl/" style="color: #10b981;">Polski</a> |
        Go to: <a href="/en/" style="color: #3b82f6;">English</a>
      </p>
    </noscript>
  </body>
</html>
