---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  lastUpdated: string;
}

const { title, description, lang, lastUpdated } = Astro.props;
const t = getTranslations(lang);
const base = "";
---

<Layout title={title} description={description} lang={lang}>
  <Header lang={lang} />
  <main>
    <div class="mx-auto max-w-3xl px-6 py-16">
      <!-- Back link -->
      <a
        href={`${base}/${lang}/`}
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-10"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {t.legal.backHome}
      </a>

      <h1 class="text-3xl font-bold tracking-tight text-foreground mb-3">{title}</h1>
      <p class="text-sm text-muted-foreground mb-10">
        {t.legal.lastUpdated}: {lastUpdated}
      </p>

      <!-- Legal content with prose-like styling -->
      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .legal-prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: #09090b;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .legal-prose :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: #09090b;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose :global(p) {
    font-size: 0.9375rem;
    color: #3f3f46;
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .legal-prose :global(ul) {
    list-style-type: disc;
  }
  .legal-prose :global(ol) {
    list-style-type: decimal;
  }
  .legal-prose :global(li) {
    font-size: 0.9375rem;
    color: #3f3f46;
    line-height: 1.75;
    margin-bottom: 0.25rem;
  }
  .legal-prose :global(a) {
    color: #09090b;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(strong) {
    color: #09090b;
    font-weight: 600;
  }
  .legal-prose :global(hr) {
    border-color: #e4e4e7;
    margin: 2rem 0;
  }
</style>
