---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const base = "";
---

<section class="relative overflow-hidden">
  <!-- subtle grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] bg-[size:40px_40px] opacity-40 pointer-events-none"></div>

  <div class="relative mx-auto max-w-5xl px-6 py-24 md:py-32">
    <!-- Heading -->
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-[1.1]">
        {t.hero.heading}
        <br />
        <span class="text-muted-foreground font-semibold">{t.hero.subheading}</span>
      </h1>

      <p class="mt-6 text-lg text-muted-foreground leading-relaxed max-w-xl mx-auto">
        {t.hero.description}
      </p>

      <!-- CTA Buttons — all coming soon -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <!-- App Store -->
        <div class="relative group">
          <button
            disabled
            aria-label={t.hero.ctaAppStore}
            class="inline-flex items-center gap-2.5 rounded-xl border border-border bg-muted px-5 py-3 text-sm font-medium text-muted-foreground cursor-not-allowed opacity-60"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            {t.hero.ctaAppStore}
          </button>
          <span class="absolute -top-2 -right-2 rounded-full bg-foreground px-1.5 py-0.5 text-[10px] font-medium text-background">
            {t.hero.comingSoon}
          </span>
        </div>

        <!-- Google Play -->
        <div class="relative group">
          <button
            disabled
            aria-label={t.hero.ctaGooglePlay}
            class="inline-flex items-center gap-2.5 rounded-xl border border-border bg-muted px-5 py-3 text-sm font-medium text-muted-foreground cursor-not-allowed opacity-60"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.18 23.76a2 2 0 0 0 2.09-.22l.08-.06 11.72-6.76-2.56-2.56zm16.6-10.41-2.55-1.47-2.86 2.86 2.86 2.86 2.57-1.48a1.5 1.5 0 0 0 0-2.77zM3.08.26a1.5 1.5 0 0 0-.82 1.36v20.76a1.5 1.5 0 0 0 .82 1.36l.1.06L14.9 12.1v-.22z"/>
            </svg>
            {t.hero.ctaGooglePlay}
          </button>
          <span class="absolute -top-2 -right-2 rounded-full bg-foreground px-1.5 py-0.5 text-[10px] font-medium text-background">
            {t.hero.comingSoon}
          </span>
        </div>

        <!-- Web App -->
        <div class="relative group">
          <a
            href="https://web.slicebill.app"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.hero.ctaWeb}
            class="inline-flex items-center gap-2.5 rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground hover:bg-muted hover:border-foreground/20 transition-all hover:scale-105 shadow-sm"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            {t.hero.ctaWeb}
          </a>
          <span class="absolute -top-2 -right-2 rounded-full bg-emerald-600 px-1.5 py-0.5 text-[10px] font-medium text-white shadow-sm flex items-center gap-1">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>
            {t.hero.availableNow}
          </span>
        </div>
      </div>
    </div>

    <!-- App Screenshot Preview -->
    <div class="mt-16 flex justify-center">
      <div class="relative w-full max-w-2xl rounded-2xl border border-border bg-card shadow-2xl shadow-foreground/5 overflow-hidden">
        <!-- Mock browser chrome -->
        <div class="flex items-center gap-1.5 border-b border-border px-4 py-3 bg-muted">
          <span class="h-3 w-3 rounded-full bg-border"></span>
          <span class="h-3 w-3 rounded-full bg-border"></span>
          <span class="h-3 w-3 rounded-full bg-border"></span>
          <span class="ml-3 flex-1 rounded-md bg-background px-3 py-1 text-xs text-muted-foreground font-mono">slicebill.app</span>
        </div>
        <!-- App UI mockup -->
        <div class="flex h-72 md:h-96">
          <!-- Sidebar -->
          <div class="hidden sm:flex w-44 flex-col border-r border-border bg-muted/50 p-3 gap-1">
            <div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Overview
            </div>
            <div class="flex items-center gap-2.5 rounded-lg bg-foreground/5 px-3 py-2 text-sm font-medium text-foreground">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Groups
            </div>
            <div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Settings
            </div>
          </div>
          <!-- Main content -->
          <div class="flex-1 p-5 overflow-auto">
            <div class="flex items-center justify-between mb-5">
              <h2 class="text-lg font-bold text-foreground">Groups</h2>
              <button class="h-7 w-7 rounded-lg border border-border flex items-center justify-center text-foreground hover:bg-muted">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
            <div class="space-y-2.5">
              {["Weekend Trip", "Apartment", "Dinner 🍕"].map((name, i) => (
                <div class="flex items-center justify-between rounded-lg border border-border px-4 py-3 bg-card">
                  <div>
                    <p class="text-sm font-medium text-foreground">{name}</p>
                    <p class="text-xs text-muted-foreground">{[3, 4, 2][i]} members</p>
                  </div>
                  <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${i === 0 ? "bg-foreground text-background" : "bg-muted text-muted-foreground"}`}>
                    {i === 0 ? "Online" : "Offline"}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
