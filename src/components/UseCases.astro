---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const icons: Record<string, string> = {
  plane: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 2a2 2 0 0 0-2 0l-3.5 3.5L5 3.8 3.2 5.6l7 3.2L6 13H3l-1 2 4 2 2 4 2-1v-3l3.8-4.2 3.2 7z"/></svg>`,
  home: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
};
---

<section class="border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <div class="max-w-2xl mb-14">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {t.useCases.heading}
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      {t.useCases.items.map((item) => (
        <div class="rounded-xl border border-border bg-card p-6">
          <div
            class="mb-5 inline-flex h-10 w-10 items-center justify-center text-foreground"
            aria-hidden="true"
            set:html={icons[item.icon]}
          />
          <h3 class="mb-2 text-base font-semibold text-foreground">{item.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
