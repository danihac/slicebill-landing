---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const icons: Record<string, string> = {
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  "wifi-off": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.56 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>`,
  currency: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
};
---

<section class="border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <!-- Section header -->
    <div class="max-w-2xl mb-14">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {t.features.heading}
      </h2>
      <p class="mt-4 text-base text-muted-foreground leading-relaxed">
        {t.features.subheading}
      </p>
    </div>

    <!-- Feature cards grid -->
    <div class="grid gap-4 sm:grid-cols-3">
      {t.features.items.map((item) => (
        <div class="group rounded-xl border border-border bg-card p-6 transition-shadow hover:shadow-md hover:shadow-foreground/5">
          <div
            class="mb-5 inline-flex h-10 w-10 items-center justify-center text-foreground"
            aria-hidden="true"
            set:html={icons[item.icon]}
          />
          <h3 class="mb-2 text-base font-semibold text-foreground">{item.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
