---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.platforms;
---

<section class="border-t border-border bg-muted/30">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <!-- Section header -->
    <div class="max-w-2xl mx-auto text-center mb-14">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {p.heading}
      </h2>
      <p class="mt-4 text-base text-muted-foreground">
        {p.subheading}
      </p>
    </div>

    <!-- Platform cards -->
    <div class="grid gap-4 sm:grid-cols-3">
      <!-- iOS -->
      <div class="rounded-xl border border-border bg-card p-6 flex flex-col items-center text-center gap-4">
        <div class="h-14 w-14 flex items-center justify-center rounded-2xl bg-muted text-foreground" aria-hidden="true">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-foreground">{p.ios.label}</p>
          <p class="text-sm text-muted-foreground mt-1">{p.ios.badge}</p>
        </div>
        <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
          {p.ios.status}
        </span>
      </div>

      <!-- Android -->
      <div class="rounded-xl border border-border bg-card p-6 flex flex-col items-center text-center gap-4">
        <div class="h-14 w-14 flex items-center justify-center rounded-2xl bg-muted text-foreground" aria-hidden="true">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.523 15.341 19 22l-7-4-7 4 1.477-6.659L1 11l7.887-.739L12 5l3.113 5.261L23 11z" opacity=".2"/>
            <path d="M6.18 15.64a2.18 2.18 0 0 0 2.18 2.18h.73v3.46a1.46 1.46 0 0 0 2.92 0v-3.46h1.95v3.46a1.46 1.46 0 0 0 2.92 0v-3.46h.73a2.18 2.18 0 0 0 2.18-2.18V9.41H6.18v6.23zM3.72 9.41a1.46 1.46 0 0 0-1.46 1.46v5.47a1.46 1.46 0 0 0 2.92 0v-5.47a1.46 1.46 0 0 0-1.46-1.46zm16.56 0a1.46 1.46 0 0 0-1.46 1.46v5.47a1.46 1.46 0 0 0 2.92 0v-5.47a1.46 1.46 0 0 0-1.46-1.46zM8.23 4.37l-.87-1.51a.28.28 0 0 0-.38-.1.28.28 0 0 0-.1.38l.89 1.54A5.54 5.54 0 0 0 6.42 8.5h11.16a5.54 5.54 0 0 0-1.35-3.82l.89-1.54a.28.28 0 0 0-.1-.38.28.28 0 0 0-.38.1l-.87 1.51A5.52 5.52 0 0 0 12 3.54a5.52 5.52 0 0 0-3.77.83zm3.77.46a.73.73 0 1 1-.73.73.73.73 0 0 1 .73-.73zm-3.28.73a.73.73 0 1 1 .73-.73.73.73 0 0 1-.73.73z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-foreground">{p.android.label}</p>
          <p class="text-sm text-muted-foreground mt-1">{p.android.badge}</p>
        </div>
        <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
          {p.android.status}
        </span>
      </div>

      <!-- Web -->
      <div class="rounded-xl border border-border bg-card p-6 flex flex-col items-center text-center gap-4">
        <div class="h-14 w-14 flex items-center justify-center rounded-2xl bg-muted text-foreground" aria-hidden="true">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-foreground">{p.web.label}</p>
          <p class="text-sm text-muted-foreground mt-1 font-mono text-xs">{p.web.url}</p>
        </div>
        <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
          {p.web.status}
        </span>
      </div>
    </div>
  </div>
</section>
